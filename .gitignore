# Secrets / local env
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies / build output
node_modules/
dist/
build/
target/
*.egg-info/
__pycache__/
.venv/
venv/

# Logs / caches
*.log
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
*.coverage

# gandalf generated output
reports/
.gandalf-baseline.json
.gandalf-cache.json
.gandalf-trend.jsonl

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
# ...except the VS Code extension's own launch config, which is how you run it
# from source (F5). Negating the directory works only because the rule above
# ends in a slash — git still descends into a re-included directory.
!editors/vscode/.vscode/
*.swp
